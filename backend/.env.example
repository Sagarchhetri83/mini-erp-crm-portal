# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/mini_erp
# Neon:    postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/mini_erp?sslmode=require
# Render:  postgresql://user:password@dpg-xxx.oregon-postgres.render.com/mini_erp
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Strong random secret for JWT signing (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-strong-random-secret

# Port the Express server listens on
PORT=3001
